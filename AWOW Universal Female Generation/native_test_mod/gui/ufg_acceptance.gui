dockable_button = { size = { 330 32 } raw_text = "UFG: Set up parent-role save test" onclick = "[ExecuteConsoleCommand('event ufg_acceptance.5')]" }
dockable_button = { size = { 330 32 } raw_text = "UFG: Check saved roles and genders" onclick = "[ExecuteConsoleCommand('event ufg_acceptance.6')]" }
dockable_button = { size = { 330 32 } raw_text = "UFG: Prepare forced-male birth" onclick = "[ExecuteConsoleCommand('event ufg_acceptance.7')]" }
