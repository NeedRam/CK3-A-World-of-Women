{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awow-ufg.invalid/schema/scenario-fixtures-v1.json",
  "title": "AWOW UFG installer scenario fixtures v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "contract_files", "scenarios"],
  "properties": {
    "$schema": {"const": "../spec/scenario-fixtures.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "ufg_scenario_fixtures"},
    "contract_files": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/path"}},
    "scenarios": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*:)[^\\\\/:*?\"<>|\\x00-\\x1F]+(?:/[^\\\\/:*?\"<>|\\x00-\\x1F]+)*$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["id", "description", "operation", "initial", "confirmation_response", "expected"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "description": {"type": "string", "minLength": 1}, "operation": {"enum": ["install", "uninstall"]}, "initial": {"$ref": "#/$defs/initial"}, "confirmation_response": {"type": ["string", "null"]}, "expected": {"$ref": "#/$defs/expected"}}},
    "initial": {"type": "object", "additionalProperties": false, "required": ["target_root_kind", "classification_hint", "ck3_running", "target_is_reparse", "ancestor_is_reparse", "files", "state_file"], "properties": {"target_root_kind": {"const": "fixture_binaries"}, "classification_hint": {"enum": ["agp_ready", "manual_ufg", "managed_ufg", "ufg_proxy_only", "unknown_conflicting"]}, "ck3_running": {"type": "boolean"}, "target_is_reparse": {"type": "boolean"}, "ancestor_is_reparse": {"type": "boolean"}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "state_file": {"enum": ["absent", "valid", "drifted", "invalid"]}, "write_fault_at": {"$ref": "#/$defs/path"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["relative_path", "kind", "sha256", "size_bytes", "owner"], "properties": {"relative_path": {"$ref": "#/$defs/path"}, "kind": {"enum": ["file", "directory"]}, "sha256": {"$ref": "#/$defs/sha"}, "size_bytes": {"type": "integer", "minimum": 0}, "owner": {"enum": ["steam", "agp_dependency", "ufg_managed", "unknown"]}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["relative_path", "action"], "properties": {"relative_path": {"$ref": "#/$defs/path"}, "action": {"enum": ["create", "replace", "remove", "restore", "preserve", "verify_only"]}}},
    "expected": {"type": "object", "additionalProperties": false, "required": ["classification", "decision", "next_state", "writes", "preserves", "quarantines", "removes", "rollback", "reason"], "properties": {"classification": {"enum": ["agp_ready", "manual_ufg", "managed_ufg", "ufg_proxy_only", "unknown_conflicting"]}, "decision": {"enum": ["proceed", "reject", "abort", "no_op", "rollback"]}, "next_state": {"enum": ["agp_ready", "manual_ufg", "managed_ufg", "ufg_proxy_only", "unknown_conflicting", "manual_recovery_required"]}, "writes": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "preserves": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "quarantines": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "removes": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "rollback": {"type": "object", "additionalProperties": false, "required": ["required", "committed_state", "restores"], "properties": {"required": {"type": "boolean"}, "committed_state": {"type": "boolean"}, "restores": {"type": "array", "items": {"$ref": "#/$defs/path"}}}}, "reason": {"type": "string", "minLength": 1}}}
  }
}
